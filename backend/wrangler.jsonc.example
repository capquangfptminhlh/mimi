{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumi-pet-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://capquangfptminhlh.github.io,http://localhost:8788,http://127.0.0.1:8788"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumi-pet-booking",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
