{
  "name": "lumi-pet-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js && node --check src/validation.js",
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lumi-pet-booking --local",
    "db:migrate:remote": "wrangler d1 migrations apply lumi-pet-booking --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
